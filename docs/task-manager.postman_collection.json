{
  "info": {
    "_postman_id": "76486efe-2895-4864-b783-708bc39282c1",
    "name": "Task Manager API",
    "description": "Taskboard REST API. Run the folder in order: Create stores `taskId` for the requests that follow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "taskId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create task",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "const task = pm.response.json().data;",
              "pm.test(\"Returns created task\", () => { pm.expect(task.id).to.be.a(\"string\"); pm.expect(task.title).to.eql(\"Finish assignment\"); });",
              "pm.collectionVariables.set(\"taskId\", task.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Finish assignment\",\n  \"description\": \"Complete the full-stack task manager\",\n  \"status\": \"pending\",\n  \"priority\": \"high\",\n  \"dueDate\": \"2026-10-05\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Create task (invalid)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Returns validation details\", () => { const { error } = pm.response.json(); pm.expect(error.message).to.eql(\"Validation failed\"); pm.expect(error.details).to.be.an(\"array\").that.is.not.empty; });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"\",\n  \"description\": \"\",\n  \"priority\": \"urgent\",\n  \"dueDate\": \"2026-02-30\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "List tasks",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Has data and meta\", () => { const body = pm.response.json(); pm.expect(body.data).to.be.an(\"array\"); pm.expect(body.meta).to.include.keys(\"page\", \"limit\", \"total\", \"totalPages\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks"
          ]
        },
        "description": ""
      }
    },
    {
      "name": "List tasks (search, filter, sort, paginate)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Only high-priority pending tasks\", () => pm.response.json().data.forEach((t) => { pm.expect(t.priority).to.eql(\"high\"); pm.expect(t.status).to.eql(\"pending\"); }));",
              "pm.test(\"Meta reflects paging\", () => { const { meta } = pm.response.json(); pm.expect(meta.page).to.eql(1); pm.expect(meta.limit).to.eql(5); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tasks?search=assignment&status=pending&priority=high&sortBy=dueDate&order=asc&page=1&limit=5",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks"
          ],
          "query": [
            {
              "key": "search",
              "value": "assignment"
            },
            {
              "key": "status",
              "value": "pending"
            },
            {
              "key": "priority",
              "value": "high"
            },
            {
              "key": "sortBy",
              "value": "dueDate"
            },
            {
              "key": "order",
              "value": "asc"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "5"
            }
          ]
        },
        "description": ""
      }
    },
    {
